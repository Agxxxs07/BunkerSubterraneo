# Texto de Unity con fin de línea consistente
* text=auto
*.cs text diff=csharp
*.unity text merge=unityyamlmerge eol=lf
*.prefab text merge=unityyamlmerge eol=lf
*.mat text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.shadergraph text eol=lf
*.inputactions text eol=lf

# Binarios
*.blend binary
*.png binary
*.exr binary
*.fbx binary
*.obj binary
